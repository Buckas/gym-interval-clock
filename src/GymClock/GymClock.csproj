<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GymClock</RootNamespace>
    <AssemblyName>GymClock</AssemblyName>
    <ApplicationIcon>GymClock.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Without this, the SDK appends the git commit hash to Version as
         "+<hash>", which shows up wherever Application.ProductVersion is
         displayed (e.g. the About dialog title) unless explicitly stripped. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Gym Interval Clock</Product>
    <AssemblyTitle>Gym Interval Clock</AssemblyTitle>
    <Description>Full-screen interval training clock for projecting onto a gym wall.</Description>
    <Version>3.1.2</Version>
    <AssemblyVersion>3.1.2.0</AssemblyVersion>
    <FileVersion>3.1.2.0</FileVersion>
    <Copyright>Copyright (c) 2026 Chris Bucknell and James Vella. All rights reserved.</Copyright>
    <Authors>Chris Bucknell; James Vella</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <NeutralLanguage>en-AU</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AI.Foundry.Local" Version="2.4.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

  <!-- The exercise library ships inside the exe; newer versions are downloaded from the same file on GitHub. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\exercises.json" LogicalName="GymClock.exercises.json" />
  </ItemGroup>

  <!--
    Publish settings live in Properties\PublishProfiles\win-x64.pubxml so that
    F5 debugging stays fast. In Visual Studio: right-click the project > Publish.
  -->

</Project>
