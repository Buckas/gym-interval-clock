<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Version 5: the new windows are WPF. Windows Forms stays until the last old window is replaced. -->
    <UseWPF>true</UseWPF>
    <!-- WPF0001: Application.ThemeMode (the built-in Fluent theme) is still marked experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GymClock</RootNamespace>
    <AssemblyName>GymClock</AssemblyName>
    <ApplicationIcon>GymClock.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Gym Interval Clock</AssemblyTitle>
    <Description>Full-screen interval training clock for projecting onto a gym wall.</Description>
    <!-- Version, Product, Copyright and Authors are in Directory.Build.props at the repository root. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <!-- Programs, settings, timing, licensing, AI logic and linked displays live in the core project. -->
  <ItemGroup>
    <ProjectReference Include="..\GymClock.Core\GymClock.Core.csproj" />
  </ItemGroup>

  <!--
    Publish settings live in Properties\PublishProfiles\win-x64.pubxml so that
    F5 debugging stays fast. In Visual Studio: right-click the project > Publish.
  -->

</Project>
