<!--
  Type, spacing and shape (build guide 3.3). These do not change with the theme.
  Text sizes are FontSize.*; the matching TextBlock styles are TextStyle.* in Controls.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="Font.Control">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Small">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">15</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.CardTitle">20</sys:Double>
    <sys:Double x:Key="FontSize.Title">28</sys:Double>
    <sys:Double x:Key="FontSize.Icon">18</sys:Double>

    <sys:Double x:Key="Height.Control">44</sys:Double>
    <sys:Double x:Key="Height.Input">40</sys:Double>
    <sys:Double x:Key="Height.Transport">64</sys:Double>
    <sys:Double x:Key="Width.Rail">232</sys:Double>

    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Thickness x:Key="Padding.Page">32,28,32,28</Thickness>
    <Thickness x:Key="Padding.Card">20</Thickness>
    <Thickness x:Key="Gap.Card">0,0,0,18</Thickness>
</ResourceDictionary>
