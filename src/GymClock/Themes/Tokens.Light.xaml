<!-- Light theme colours (build guide 3.2): the same keys as Tokens.Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface.App" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Surface.Rail" Color="#E9EBEF" />
    <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#F0F2F5" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#E3EEFF" />
    <SolidColorBrush x:Key="Surface.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border.Card" Color="#DDE1E7" />
