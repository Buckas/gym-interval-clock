<!--
  Dark theme colours (build guide 3.2). Every palette file defines exactly the same keys;
  ThemeTokenTests checks that. Use them with DynamicResource so a theme change applies live.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface.App" Color="#12151A" />
    <SolidColorBrush x:Key="Surface.Rail" Color="#0D1014" />
    <SolidColorBrush x:Key="Surface.Card" Color="#1B2027" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#232A33" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#1C2733" />
    <SolidColorBrush x:Key="Surface.Input" Color="#12151A" />
    <SolidColorBrush x:Key="Border.Card" Color="#2A313B" />
    <SolidColorBrush x:Key="Border.Control" Color="#3A4450" />
    <SolidColorBrush x:Key="Border.Dashed" Color="#5B6775" />
    <SolidColorBrush x:Key="Text.Primary" Color="#F1F3F6" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#C9D1DB" />
    <SolidColorBrush x:Key="Text.Muted" Color="#A7B0BC" />
    <SolidColorBrush x:Key="Accent" Color="#5AA2FF" />
    <SolidColorBrush x:Key="Accent.On" Color="#0B1220" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#1E2F4D" />
    <SolidColorBrush x:Key="Accent.SoftText" Color="#A9CBFF" />
    <SolidColorBrush x:Key="Success" Color="#4CC38A" />
    <SolidColorBrush x:Key="Success.Soft" Color="#1D3A2B" />
    <SolidColorBrush x:Key="Success.SoftText" Color="#7FE0AE" />
    <SolidColorBrush x:Key="Warning.Soft" Color="#3A2A14" />
    <SolidColorBrush x:Key="Warning.SoftText" Color="#F3C98B" />
    <SolidColorBrush x:Key="Danger" Color="#F27F77" />
    <SolidColorBrush x:Key="Danger.Soft" Color="#3D1F1F" />
    <SolidColorBrush x:Key="Danger.SoftText" Color="#F6B4AE" />
    <SolidColorBrush x:Key="Bubble.User" Color="#24456F" />
</ResourceDictionary>
