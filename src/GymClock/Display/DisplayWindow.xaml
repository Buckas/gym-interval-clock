<!--
  The clock on the projector (build guide P3.4). Full screen and borderless by default; F11 or
  Esc gives a normal window. Style is cleared so WPF's Fluent window look (backdrop, rounded
  frame) never touches the clock.
-->
<Window x:Class="GymClock.Wpf.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GymClock.Wpf"
        Style="{x:Null}"
        Background="Black"
        Width="1280" Height="720" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FocusVisualStyle="{x:Null}">
    <Grid x:Name="Root" Background="Black">
        <local:ClockSurface x:Name="Surface" />
        <!-- The control bar, scaled into the strip the clock keeps for it (ClockSurface.BarSlot). -->
        <Canvas>
            <Viewbox x:Name="BarBox" Stretch="Uniform" StretchDirection="Both" Visibility="Collapsed">
                <local:ControlBar x:Name="Bar" />
            </Viewbox>
        </Canvas>
    </Grid>
</Window>
