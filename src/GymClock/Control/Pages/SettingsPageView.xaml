<!-- The Settings page (build guide 7.2, mockup 9). DataContext: SettingsViewModel. -->
<UserControl x:Class="GymClock.Wpf.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymClock.Wpf">
    <UserControl.Resources>
        <!-- A layout choice drawn as a small picture of the clock. -->
        <Style x:Key="LayoutCard" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="8" BorderThickness="1"
                                Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Control}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}">
            <DockPanel Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextStyle.Small}" Text="Changes apply straight away" VerticalAlignment="Bottom" />
                <TextBlock Style="{StaticResource TextStyle.PageTitle}" Text="Settings" Margin="0" />
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- ============================================ display layout -->
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Display layout" Margin="0,0,0,12" />
                            <ListBox SelectedIndex="{Binding LayoutIndex}" ItemContainerStyle="{StaticResource LayoutCard}"
                                     Background="Transparent" BorderThickness="0" AutomationProperties.Name="Display layout"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem AutomationProperties.Name="Standard">
                                    <StackPanel>
                                        <Border Height="70" CornerRadius="6" Background="#0F8A46" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Border Background="#0A6634" CornerRadius="3" />
                                                <TextBlock Grid.Column="1" Text="34" FontSize="30" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Standard" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource Text.Primary}" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="Big number">
                                    <StackPanel>
                                        <Border Height="70" CornerRadius="6" Background="#0F8A46">
                                            <TextBlock Text="34" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Big number" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource Text.Primary}" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem AutomationProperties.Name="Stations">
                                    <StackPanel>
                                        <Border Height="70" CornerRadius="6" Background="#0F8A46" Padding="5">
                                            <UniformGrid Columns="2">
                                                <Border Background="#0A6634" CornerRadius="3" Margin="0,0,4,0" />
                                                <TextBlock Text="34" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="Stations" FontSize="13" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource Text.Primary}" />
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>
                            <TextBlock Text="{Binding SafeMarginText}" Margin="0,14,0,4" />
                            <Slider Minimum="0" Maximum="8" Value="{Binding SafeMargin}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="Safe margin" />
                            <CheckBox Content="Show the control bar when the mouse moves" IsChecked="{Binding ControlBar}" Margin="0,8,0,0" />
                            <CheckBox Content="Reduce motion (no fades or countdown pulse)" IsChecked="{Binding ReduceMotion}" />
                            <TextBlock Style="{StaticResource TextStyle.Small}" Margin="28,0,0,0"
                                       Text="When unticked, the clock follows Windows' animation setting." />
                        </StackPanel>
                    </Border>

                    <!-- ============================================ colours -->
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Reset colours" Command="{Binding ResetColours}" MinHeight="32" Padding="10,0" />
                                <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Phase colours" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Colours}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Base}" Background="{Binding Fill}" Foreground="{Binding Ink}"
                                                BorderBrush="{DynamicResource Border.Control}" BorderThickness="1" FontWeight="Bold" Padding="14,0" Margin="0,0,8,8"
                                                Content="{Binding Name}" Command="{Binding Pick}" ToolTip="{Binding Hex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource TextStyle.Small}" Text="Click a colour to change it." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- ============================================ appearance -->
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Appearance" Margin="0,0,0,12" />
                            <ListBox Style="{StaticResource SegmentedControl}" SelectedIndex="{Binding ThemeIndex}"
                                     AutomationProperties.Name="Theme for the Control window">
                                <ListBoxItem>Follow Windows</ListBoxItem>
                                <ListBoxItem>Light</ListBoxItem>
                                <ListBoxItem>Dark</ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ sound -->
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Sound" Margin="0,0,0,6" />
                            <CheckBox Content="Play the sound cues" IsChecked="{Binding SoundEnabled}" />
                            <TextBlock Text="{Binding VolumeText}" Margin="0,6,0,4" />
                            <Slider Minimum="5" Maximum="100" Value="{Binding Volume}" SmallChange="5" LargeChange="10" AutomationProperties.Name="Volume" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Get-ready countdown" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <local:NumberBox Value="{Binding PrepSeconds}" Minimum="0" Maximum="300" Step="5" Width="96"
                                                 AutomationProperties.Name="Get-ready countdown in seconds" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ clock and stations -->
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Clock and stations" Margin="0,0,0,6" />
                            <CheckBox Content="Show the time of day" IsChecked="{Binding ShowClock}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Time format" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox IsEditable="True" Width="170" Text="{Binding ClockFormat, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{x:Static local:SettingsViewModel.ClockFormats}" AutomationProperties.Name="Time format" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding ClockExample}" Margin="0,4,0,6" />
                            <CheckBox Content="Keep the clock on top of other windows" IsChecked="{Binding AlwaysOnTop}" />
                            <CheckBox Content="Show the station list on the clock" IsChecked="{Binding ShowStationsTable}" />
                            <CheckBox Content="Show the station name instead of WORK / REST" IsChecked="{Binding ShowStationNameAsDescription}" />
                            <TextBlock Style="{StaticResource TextStyle.Small}" Margin="28,0,0,0"
                                       Text="Only when the whole class is at one station (Sequential, or a simple session)." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding SettingsFileText}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
