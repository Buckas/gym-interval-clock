<!-- The Session page (build guide 7.1, mockup 4). DataContext: SessionViewModel. -->
<UserControl x:Class="GymClock.Wpf.SessionPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymClock.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}">
            <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Success}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScreenText}" />
                </Border>
                <TextBlock Style="{StaticResource TextStyle.PageTitle}" Text="Session" Margin="0" />
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!-- ============================================ now running -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextStyle.Caption}" Text="NOW RUNNING" />
                        <TextBlock Style="{StaticResource TextStyle.CardTitle}" Text="{Binding ProgramName}" Margin="0,4,0,2" />
                        <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding Description}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <Border CornerRadius="11" Padding="12,4" HorizontalAlignment="Left" Background="{Binding PhaseBrush}">
                                    <TextBlock Text="{Binding PhaseTag}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                </Border>
                                <TextBlock Text="{Binding Countdown}" FontFamily="{StaticResource Font.Display}" FontSize="56" FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StationLine}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text.Primary}" />
                                <TextBlock Style="{StaticResource TextStyle.Body}" Text="{Binding RoundLine}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="8" Margin="0,16,0,0"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource VisibleWhenTrue}}"
                                     AutomationProperties.Name="Time left in this interval" />

                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <Button Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                    Command="{Binding Back}" ToolTip="Back (Left arrow)" AutomationProperties.Name="Back">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Back}" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" FontSize="15" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                    Command="{Binding Pause}" ToolTip="Start or pause (Space)" AutomationProperties.Name="{Binding PauseText}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TextStyle.Icon}" Text="{Binding PauseGlyph}" Margin="0,0,8,0" /><TextBlock Text="{Binding PauseText}" VerticalAlignment="Center" FontSize="17" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                    Command="{Binding Skip}" ToolTip="Skip (Right arrow)" AutomationProperties.Name="Skip">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Skip}" Margin="0,0,8,0" /><TextBlock Text="Skip" VerticalAlignment="Center" FontSize="15" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64"
                                    Command="{Binding Reset}" ToolTip="Reset (R)" AutomationProperties.Name="Reset">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Reset}" Margin="0,0,8,0" /><TextBlock Text="Reset" VerticalAlignment="Center" FontSize="15" /></StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Style="{StaticResource InfoBar.Info}" Margin="0,14,0,0"
                                Visibility="{Binding IsFollowing, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="The main PC has the controls. This screen follows its session." TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,20,0,0" Visibility="{Binding ShowStations, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="JUMP TO STATION" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Stations}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="22" FontWeight="Normal"
                                                Content="{Binding Label}" Command="{Binding Jump}" Margin="0,0,8,8"
                                                ToolTip="Jump straight to this station (number keys on the clock)" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================ right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="UP NEXT" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding UpNext}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" Foreground="{DynamicResource Text.Secondary}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Primary}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="SOUND" Margin="0,0,0,4" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Play the sound cues" IsChecked="{Binding SoundOn}" />
                            <TextBlock Text="{Binding VolumeText}" Margin="0,8,0,4" />
                            <Slider Minimum="5" Maximum="100" Value="{Binding Volume}" SmallChange="5" LargeChange="10"
                                    AutomationProperties.Name="Volume" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="DISPLAY" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Standard}" Content="Move to next screen (F6)" Margin="0,0,8,8"
                                        Command="{Binding MoveToNextScreen}" />
                                <Button Style="{StaticResource Button.Standard}" Content="{Binding FullScreenText}" Margin="0,0,8,8"
                                        Command="{Binding ToggleFullScreen}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding LinkLine}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
