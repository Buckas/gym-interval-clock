<!--
  The style gallery (build guide P2.6): every style in Controls.xaml, so the look can be checked
  against the mockups in each theme. Ctrl+Shift+G in the Control window. Not for teachers.
-->
<UserControl x:Class="GymClock.Wpf.GalleryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymClock.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}">

            <DockPanel Margin="0,0,0,18">
                <ListBox x:Name="ThemePicker" DockPanel.Dock="Right" Style="{StaticResource SegmentedControl}" Width="440"
                         AutomationProperties.Name="Theme" SelectionChanged="ThemePicker_SelectionChanged">
                    <ListBoxItem Tag="system">Follow Windows</ListBoxItem>
                    <ListBoxItem Tag="light">Light</ListBoxItem>
                    <ListBoxItem Tag="dark">Dark</ListBoxItem>
                </ListBox>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextStyle.PageTitle}" Text="Style gallery" Margin="0" />
                    <TextBlock Style="{StaticResource TextStyle.Small}" Margin="0,4,0,0"
                               Text="Hover, press and Tab through the controls to see their other states. The theme picker here does not save." />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ======================================================== left column -->
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Buttons" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Primary}" Content="Start" Margin="0,0,8,8" ToolTip="Button.Primary" />
                                <Button Style="{StaticResource Button.Standard}" Content="Load program" Margin="0,0,8,8" ToolTip="Button.Standard" />
                                <Button Style="{StaticResource Button.Subtle}" Content="More options" Margin="0,0,8,8" ToolTip="Button.Subtle" />
                                <Button Style="{StaticResource Button.Danger}" Content="Delete" Margin="0,0,8,8" ToolTip="Button.Danger" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="DISABLED" Margin="0,8,0,8" />
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Primary}" Content="Start" Margin="0,0,8,8" IsEnabled="False" />
                                <Button Style="{StaticResource Button.Standard}" Content="Load program" Margin="0,0,8,8" IsEnabled="False" />
                                <Button Style="{StaticResource Button.Subtle}" Content="More options" Margin="0,0,8,8" IsEnabled="False" />
                                <Button Style="{StaticResource Button.Danger}" Content="Delete" Margin="0,0,8,8" IsEnabled="False" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="TRANSPORT (SESSION PAGE SIZES)" Margin="0,8,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                        AutomationProperties.Name="Back" ToolTip="Back">
                                    <TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Back}" />
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                        AutomationProperties.Name="Pause" ToolTip="Pause">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Pause}" Margin="0,0,8,0" />
                                        <TextBlock Text="Pause" FontSize="17" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64" Margin="0,0,8,0"
                                        AutomationProperties.Name="Skip" ToolTip="Skip">
                                    <TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Skip}" />
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource Button.Standard}" local:Ui.CornerRadius="12" MinHeight="64"
                                        AutomationProperties.Name="Reset" ToolTip="Reset">
                                    <TextBlock Style="{StaticResource TextStyle.Icon}" Text="{x:Static local:Icons.Reset}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Inputs" Margin="0,0,0,12" />
                            <TextBox Text="Burpees" Margin="0,0,0,10" />
                            <TextBox Text="Disabled text box" IsEnabled="False" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Get-ready countdown" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <local:NumberBox Value="10" Minimum="0" Maximum="300" Width="96" AutomationProperties.Name="Get-ready countdown" />
                                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Time format" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox SelectedIndex="0" Width="180">
                                    <ComboBoxItem>8:39 PM</ComboBoxItem>
                                    <ComboBoxItem>20:39</ComboBoxItem>
                                    <ComboBoxItem>8:39:22 PM</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="Show the time of day" IsChecked="True" />
                            <CheckBox Content="Reduce motion (no fades or pulses)" />
                            <CheckBox Content="Disabled check box" IsEnabled="False" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Play the sound cues" IsChecked="True" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Keep the Display on top" />
                            <TextBlock Text="Volume: 85%" Margin="0,10,0,4" />
                            <Slider Minimum="0" Maximum="100" Value="85" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================================================== right column -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Selection" Margin="0,0,0,12" />
                            <ListBox Style="{StaticResource SegmentedControl}" SelectedIndex="0" Margin="0,0,0,12"
                                     AutomationProperties.Name="Display layout">
                                <ListBoxItem>Standard</ListBoxItem>
                                <ListBoxItem>Big number</ListBoxItem>
                                <ListBoxItem>Stations</ListBoxItem>
                            </ListBox>
                            <ListBox SelectedIndex="1" Height="132" AutomationProperties.Name="Programs">
                                <ListBoxItem>Whole Group HIIT</ListBoxItem>
                                <ListBoxItem>Pyramid Cardio Circuit</ListBoxItem>
                                <ListBoxItem>Rotating Group Circuit</ListBoxItem>
                                <ListBoxItem>Team Tabata Blast</ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Tags and info bars" Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource Tag.Success}" Margin="0,0,8,8"><TextBlock Text="RUNNING NOW" /></Border>
                                <Border Style="{StaticResource Tag.Accent}" Margin="0,0,8,8"><TextBlock Text="EACH STATION ITS OWN CLOCK" /></Border>
                                <Border Style="{StaticResource Tag.Warning}" Margin="0,0,8,8"><TextBlock Text="GROUPS ROTATE, ONE CLOCK" /></Border>
                                <Border Style="{StaticResource Tag.Neutral}" Margin="0,0,8,8"><TextBlock Text="SIMPLE SESSION" /></Border>
                            </WrapPanel>
                            <Border Style="{StaticResource InfoBar.Info}" Margin="0,0,0,8"><TextBlock TextWrapping="Wrap" Text="Second screens follow this PC. Code 4821." /></Border>
                            <Border Style="{StaticResource InfoBar.Success}" Margin="0,0,0,8"><TextBlock TextWrapping="Wrap" Text="Program saved." /></Border>
                            <Border Style="{StaticResource InfoBar.Warning}" Margin="0,0,0,8"><TextBlock TextWrapping="Wrap" Text="The local AI is still starting." /></Border>
                            <Border Style="{StaticResource InfoBar.Error}"><TextBlock TextWrapping="Wrap" Text="That file is not a Gym Clock program." /></Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Selected}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Caption}" Text="NOW RUNNING" />
                            <TextBlock Style="{StaticResource TextStyle.CardTitle}" Text="Buckers the ultimate athlete" Margin="0,4,0,4" />
                            <TextBlock Style="{StaticResource TextStyle.Body}" Text="Circuit, 4 stations, 19 minutes. This card uses Card.Selected." />
                            <TextBlock Style="{StaticResource TextStyle.Small}" Text="Small text: 13, muted." Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Icons" Margin="0,0,0,12" />
                            <ItemsControl x:Name="IconList" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="84" Margin="0,0,4,10">
                                            <TextBlock Style="{StaticResource TextStyle.Icon}" Text="{Binding Value}" FontSize="20" />
                                            <TextBlock Text="{Binding Key}" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
