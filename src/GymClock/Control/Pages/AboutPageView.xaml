<!-- The About page and the licence check (build guide 7.4). DataContext: AboutViewModel. -->
<UserControl x:Class="GymClock.Wpf.AboutPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymClock.Wpf">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Padding.Page}" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TextStyle.PageTitle}" Text="About" />

            <!-- ============================================ product -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextStyle.CardTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding Copyright}" Margin="0,4,0,0" />
                    <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Margin="-12,8,0,0"
                            Content="{Binding UpdateText}" Command="{Binding OpenUpdate}" Foreground="{DynamicResource Accent}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
            </Border>

            <!-- ============================================ licence -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="Licence" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="15"
                               Foreground="{Binding StatusState, Converter={StaticResource LineStateBrush}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="This computer's ID:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True" Width="220" AutomationProperties.Name="This computer's ID" />
                        <Button Style="{StaticResource Button.Standard}" Content="Copy" Margin="8,0,0,0" Command="{Binding CopyMachineId}" />
                    </StackPanel>

                    <TextBlock Text="Licence key:" Margin="0,16,0,6" />
                    <TextBox Text="{Binding LicenceKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="64" VerticalContentAlignment="Top" AutomationProperties.Name="Licence key" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Activate" Margin="0,0,8,8" Command="{Binding Activate}" />
                        <Button Style="{StaticResource Button.Standard}" Content="Load from file..." Margin="0,0,8,8" Command="{Binding FromFile}" />
                        <Button Style="{StaticResource Button.Standard}" Content="{Binding CheckOnlineText}" Margin="0,0,8,8" Command="{Binding CheckOnline}" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource TextStyle.Body}" Margin="0,8,0,0" Text="To request a licence, copy the computer ID above and apply at:" />
                    <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Margin="-12,0,0,0" Content="{Binding SiteUrl}"
                            Command="{Binding OpenSite}" Foreground="{DynamicResource Accent}" />
                    <TextBlock Style="{StaticResource TextStyle.Small}" Text="{Binding FollowUp}" />
                </StackPanel>
            </Border>

            <!-- ============================================ request a licence -->
            <Border x:Name="RequestCard" Style="{StaticResource Card}" Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Command="{Binding ToggleRequest}">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Request a licence" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRequest}" Value="True">
                                                    <Setter Property="Text" Value="Hide" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Style="{StaticResource TextStyle.Subtitle}" Text="{Binding RequestHeading}" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Visibility="{Binding ShowRequest, Converter={StaticResource VisibleWhenTrue}}" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource TextStyle.Body}" Text="{Binding RequestBlurb}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Your name" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Your name" />
                            <TextBlock Grid.Row="1" Text="School or organisation" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding School, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="School or organisation" />
                            <TextBlock Grid.Row="2" Text="Your email" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Your email" />
                            <TextBlock Grid.Row="3" Text="This computer is" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RequestKindNames}" SelectedIndex="{Binding RequestKind}" Margin="0,0,0,8"
                                      AutomationProperties.Name="This computer is" />
                            <TextBlock Grid.Row="4" Text="Anything else" VerticalAlignment="Center" Margin="0,0,12,8" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" AutomationProperties.Name="Anything else" />
                        </Grid>
                        <TextBlock Text="This is what will be sent:" Margin="0,8,0,6" />
                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                 Height="200" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="What will be sent" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Open in email" Margin="0,0,8,8" Command="{Binding SendRequest}" />
                            <Button Style="{StaticResource Button.Standard}" Content="Copy details" Margin="0,0,8,8" Command="{Binding CopyRequest}" />
                            <Button Style="{StaticResource Button.Standard}" Content="Open web page" Margin="0,0,8,8" Command="{Binding OpenWebPage}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{Binding CloseText}" Command="{Binding Close}" MinWidth="96"
                        Visibility="{Binding Blocking, Converter={StaticResource VisibleWhenTrue}}" />
                <Button Style="{StaticResource Button.Standard}" Content="Save report..." HorizontalAlignment="Left" Command="{Binding SaveReport}"
                        ToolTip="A text file for the authors if they ask for one. Nothing is sent by the app." />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
